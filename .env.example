# ====================================================================
# Zarii IELTS - Environment Variables Template
# Free Supabase Tier Setup: https://supabase.com
# ====================================================================

# 1. Supabase Client Credentials (Required for Live Cloud Backend)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# 2. Supabase Service Role Key (Admin / Seed Scripts ONLY - NEVER commit or expose to client)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. First Administrator Provisioning (Used by scripts/seed-first-admin.js)
ADMIN_EMAIL=admin@zarii.app
ADMIN_PASSWORD=AdminSecure2026!

# 4. Optional Client Configurations
VITE_APP_ENV=development
