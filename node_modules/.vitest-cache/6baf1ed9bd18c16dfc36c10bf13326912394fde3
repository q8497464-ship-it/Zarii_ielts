const sections = /* #__PURE__ */ JSON.parse("[{\"sectionNumber\":1,\"title\":\"Community Bicycle Cooperative Repair & Rental\",\"contextDescription\":\"A customer, Sarah Jenkins, booking a bicycle tune-up and weekend hire at the GreenSpoke Bike Co-op.\",\"audioScript\":[{\"speaker\":\"Mechanic\",\"text\":\"Welcome to GreenSpoke Cooperative! How's your bicycle running today?\"},{\"speaker\":\"Sarah\",\"text\":\"Hello! I commute daily on my hybrid commuter bike, but recently the rear gear shifting has been slipping, especially on hills. Also, the rear brake feels quite spongy.\"},{\"speaker\":\"Mechanic\",\"text\":\"Alright, let me inspect it. Ah yes, your derailleur cable has stretched, and the rear brake pads are worn down to the metal indicators. We can replace both cables and install new ceramic compound pads.\"},{\"speaker\":\"Sarah\",\"text\":\"That sounds great. What's the total estimate for parts and labor?\"},{\"speaker\":\"Mechanic\",\"text\":\"The full safety overhaul comes to forty-five pounds for parts plus twenty pounds labor, so sixty-five pounds total.\"},{\"speaker\":\"Sarah\",\"text\":\"Perfect. When will it be ready for collection?\"},{\"speaker\":\"Mechanic\",\"text\":\"We can have it ready tomorrow by four thirty in the afternoon. Let me take down your contact details. What is your full name?\"},{\"speaker\":\"Sarah\",\"text\":\"It's Sarah Jenkins, that's J-E-N-K-I-N-S, and my phone number is zero seven seven zero zero, nine zero zero four five two.\"},{\"speaker\":\"Mechanic\",\"text\":\"Got it. Now, you mentioned on the phone that you also wanted to rent a touring e-bike for your sister visiting this weekend?\"},{\"speaker\":\"Sarah\",\"text\":\"Yes, exactly! From Saturday morning to Sunday evening.\"},{\"speaker\":\"Mechanic\",\"text\":\"No problem. Our e-bike rental includes a high-capacity lithium battery with a range of eighty kilometers, an approved safety helmet, and a heavy-duty steel U-lock. Just ensure that the battery is recharged only using the supplied fifty-watt adapter.\"},{\"speaker\":\"Sarah\",\"text\":\"Understood. And what time must the rental bike be returned on Sunday?\"},{\"speaker\":\"Mechanic\",\"text\":\"Our shop closes at six in the evening on Sundays, but you can drop the bike into our automated electronic storage shed anytime until eight thirty PM using the PIN code seven four one zero.\"},{\"speaker\":\"Sarah\",\"text\":\"Seven four one zero. That's super convenient. Thank you so much!\"}],\"questionGroups\":[{\"groupInstruction\":\"Complete the form below. Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer. Write your answers in boxes 1–10.\",\"questionType\":\"sentence_completion\",\"questions\":[{\"id\":\"l2-q1\",\"questionNumber\":1,\"prompt\":\"Customer's bicycle style: hybrid ____ bike.\",\"correctAnswer\":\"commuter\",\"explanation\":\"Sarah states: 'commute daily on my hybrid commuter bike'.\",\"evidence\":\"I commute daily on my hybrid commuter bike\"},{\"id\":\"l2-q2\",\"questionNumber\":2,\"prompt\":\"Parts needing renewal: gear cables and ceramic compound ____.\",\"correctAnswer\":[\"brake pads\",\"pads\"],\"explanation\":\"Mechanic states: 'replace both cables and install new ceramic compound pads.'\",\"evidence\":\"replace both cables and install new ceramic compound pads.\"},{\"id\":\"l2-q3\",\"questionNumber\":3,\"prompt\":\"Total quoted price including parts and labor: £____\",\"correctAnswer\":[\"65\",\"sixty-five\",\"65 pounds\"],\"explanation\":\"Mechanic explains: 'so sixty-five pounds total.'\",\"evidence\":\"forty-five pounds for parts plus twenty pounds labor, so sixty-five pounds total.\"},{\"id\":\"l2-q4\",\"questionNumber\":4,\"prompt\":\"Collection pickup time tomorrow: ____ PM.\",\"correctAnswer\":[\"4:30\",\"4.30\",\"four thirty\"],\"explanation\":\"Mechanic states: 'ready tomorrow by four thirty in the afternoon.'\",\"evidence\":\"ready tomorrow by four thirty in the afternoon.\"},{\"id\":\"l2-q5\",\"questionNumber\":5,\"prompt\":\"Customer's surname: ____.\",\"correctAnswer\":\"Jenkins\",\"explanation\":\"Sarah spells J-E-N-K-I-N-S.\",\"evidence\":\"It's Sarah Jenkins, that's J-E-N-K-I-N-S\"},{\"id\":\"l2-q6\",\"questionNumber\":6,\"prompt\":\"Rental e-bike maximum distance battery range: ____ kilometers.\",\"correctAnswer\":[\"80\",\"eighty\"],\"explanation\":\"Mechanic mentions: 'with a range of eighty kilometers'.\",\"evidence\":\"with a range of eighty kilometers, an approved safety helmet\"},{\"id\":\"l2-q7\",\"questionNumber\":7,\"prompt\":\"Type of bicycle lock supplied: steel ____.\",\"correctAnswer\":[\"U-lock\",\"u lock\"],\"explanation\":\"Mechanic specifies: 'and a heavy-duty steel U-lock.'\",\"evidence\":\"and a heavy-duty steel U-lock.\"},{\"id\":\"l2-q8\",\"questionNumber\":8,\"prompt\":\"Charger rating to be used exclusively: ____ watts.\",\"correctAnswer\":[\"50\",\"fifty\"],\"explanation\":\"Mechanic emphasizes: 'using the supplied fifty-watt adapter.'\",\"evidence\":\"using the supplied fifty-watt adapter.\"},{\"id\":\"l2-q9\",\"questionNumber\":9,\"prompt\":\"Latest evening time for electronic storage shed return on Sunday: ____ PM.\",\"correctAnswer\":[\"8:30\",\"8.30\",\"eight thirty\"],\"explanation\":\"Mechanic says: 'automated electronic storage shed anytime until eight thirty PM'.\",\"evidence\":\"drop the bike into our automated electronic storage shed anytime until eight thirty PM\"},{\"id\":\"l2-q10\",\"questionNumber\":10,\"prompt\":\"Four-digit shed entry PIN code: ____.\",\"correctAnswer\":\"7410\",\"explanation\":\"Mechanic states: 'PIN code seven four one zero.'\",\"evidence\":\"PIN code seven four one zero.\"}]}]},{\"sectionNumber\":2,\"title\":\"Kingfisher Marshes Wetland Sanctuary Orientation\",\"contextDescription\":\"A guided orientation by park warden Douglas Evans describing trails and observation hides at the wetland nature reserve.\",\"audioScript\":[{\"speaker\":\"Warden\",\"text\":\"Good morning and welcome to the Kingfisher Marshes Wetland Sanctuary. Spread across four hundred hectares of tidal salt marsh and reed beds, this protected reserve hosts over two hundred migratory waterfowl species.\"},{\"speaker\":\"Warden\",\"text\":\"Please take a look at the orientation map in front of you. We are gathered here at the Visitor Center and Car Park at the bottom of the map.\"},{\"speaker\":\"Warden\",\"text\":\"Directly leading north from the center is our elevated wooden boardwalk. As you proceed along the main boardwalk, take the first right fork leading into the willow trees. Nestled at the end of this short spur, marked as Location A, is the Dragonfly Observation Platform, where water lilies bloom throughout summer.\"},{\"speaker\":\"Warden\",\"text\":\"Returning to the main boardwalk and continuing north over the tidal sluice bridge, you will see a large wooden hide on your left overlooking the tidal lagoon. This is Location B, our Heron Watching Hide, fitted with specialized tinted glass windows.\"},{\"speaker\":\"Warden\",\"text\":\"Further north, where the trail crosses into the deep reed bed zone, you'll encounter a three-story timber tower marked as Location C. That is the Otter Lookout Tower, offering prime vantage points at dawn and dusk.\"},{\"speaker\":\"Warden\",\"text\":\"If you follow the eastern branch of the boardwalk loop around the freshwater lagoon, marked at Location D on the eastern shoreline, you'll find the Pond Dipping Shelter, where educational groups study aquatic macroinvertebrates.\"},{\"speaker\":\"Warden\",\"text\":\"Finally, at the northernmost boundary of the reserve adjacent to the tidal sea wall, marked as Location E, sits the Coastal Wader Blind, designed for viewing rare curlews and godwits.\"},{\"speaker\":\"Warden\",\"text\":\"A brief reminder: because noise carries easily across open water, mobile phones must be silenced. Please remain on marked timber paths to avoid disturbing ground-nesting lapwings.\"}],\"questionGroups\":[{\"groupInstruction\":\"Label the map below. Choose 