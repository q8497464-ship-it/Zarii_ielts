const sections = /* #__PURE__ */ JSON.parse("[{\"sectionNumber\":1,\"title\":\"Alpine Hiking Club Guided Expedition Booking\",\"contextDescription\":\"Rajesh (Indian English speaker) enquiring with Lead Mountaineering Guide Thomas (Scottish / British English speaker) about registering for a guided winter traverse in the Cairngorm Mountains.\",\"audioScript\":[{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Good morning! Cairngorm Alpine Mountaineering Club. Thomas speaking.\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"Good morning, Thomas! My name is Rajesh Patel. I am looking to book a place on your five-day winter alpine ridge traverse next month.\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Grand, Rajesh! The Cairngorms in winter are spectacular, but they demand serious preparation. Let me take down your contact and experience details.\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"Certainly. My first name is Rajesh, R-A-J-E-S-H, and my surname is Patel, P-A-T-E-L.\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Thank you, Rajesh. And your contact mobile number?\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"It is zero seven nine eight seven, six five four three two zero.\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Got it. And what is your residential address?\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"I live at thirty-one Glenmore Close, Aviemore, postcode P-H-twenty-two, one-Q-R.\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"P-H-twenty-two, one-Q-R. Now regarding technical mountaineering experience, have you previously completed winter ascents using crampons and a mountaineering ice axe?\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"Yes, I completed a Scottish Winter Skills Level Two course in Glencoe last January, covering self-arrest and snow shelter construction.\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Excellent! That meets our prerequisite. The full expedition fee is five hundred and twenty pounds, which includes shared lodge accommodation and mountain guide instruction.\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"What specialized safety hardware must participants carry?\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Every climber must carry a certified digital avalanche transceiver, a collapsible carbon snow probe, and a metal shovel blade. We provide the transceivers, but you must bring your own B2-rated mountaineering boots compatible with semi-automatic crampons.\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"Understood. When does the expedition assemble?\"},{\"speaker\":\"Thomas (Scottish/British)\",\"text\":\"Our mandatory gear check and safety briefing begins at eight in the evening on Sunday, January the twelfth, at the Pine Lodge Mountain Base.\"},{\"speaker\":\"Rajesh (Indian English)\",\"text\":\"Sunday, January the twelfth at eight PM. Thank you so much, Thomas. See you in Aviemore!\"}],\"questionGroups\":[{\"groupInstruction\":\"Complete the form below. Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer. Write your answers in boxes 1–10.\",\"questionType\":\"sentence_completion\",\"questions\":[{\"id\":\"l11-q1\",\"questionNumber\":1,\"type\":\"sentence_completion\",\"topic\":\"mountaineering\",\"estimatedBand\":5.5,\"prompt\":\"Applicant surname: ____\",\"correctAnswer\":\"Patel\",\"explanation\":\"Rajesh spells his surname: P-A-T-E-L.\",\"evidence\":\"surname is Patel, P-A-T-E-L.\"},{\"id\":\"l11-q2\",\"questionNumber\":2,\"type\":\"sentence_completion\",\"topic\":\"contact\",\"estimatedBand\":5.5,\"prompt\":\"Contact mobile number: 07987 ____\",\"correctAnswer\":\"654320\",\"explanation\":\"Rajesh states: zero seven nine eight seven, six five four three two zero.\",\"evidence\":\"zero seven nine eight seven, six five four three two zero.\"},{\"id\":\"l11-q3\",\"questionNumber\":3,\"type\":\"sentence_completion\",\"topic\":\"address\",\"estimatedBand\":6,\"prompt\":\"Address: 31 ____ Close, Aviemore.\",\"correctAnswer\":\"Glenmore\",\"explanation\":\"Rajesh states thirty-one Glenmore Close.\",\"evidence\":\"thirty-one Glenmore Close, Aviemore\"},{\"id\":\"l11-q4\",\"questionNumber\":4,\"type\":\"sentence_completion\",\"topic\":\"postcode\",\"estimatedBand\":6,\"prompt\":\"Postcode: ____\",\"correctAnswer\":[\"PH22 1QR\",\"PH221QR\",\"PH22\",\"P H twenty two one Q R\"],\"explanation\":\"Rajesh gives postcode P-H-twenty-two, one-Q-R.\",\"evidence\":\"postcode P-H-twenty-two, one-Q-R.\"},{\"id\":\"l11-q5\",\"questionNumber\":5,\"type\":\"sentence_completion\",\"topic\":\"qualifications\",\"estimatedBand\":6.5,\"prompt\":\"Prerequisite: completed Scottish Winter Skills Level ____.\",\"correctAnswer\":[\"Two\",\"2\"],\"explanation\":\"Rajesh completed a Scottish Winter Skills Level Two course.\",\"evidence\":\"Scottish Winter Skills Level Two course in Glencoe\"},{\"id\":\"l11-q6\",\"questionNumber\":6,\"type\":\"sentence_completion\",\"topic\":\"finance\",\"estimatedBand\":6,\"prompt\":\"Total expedition fee: £____\",\"correctAnswer\":[\"520\",\"five hundred and twenty\"],\"explanation\":\"Thomas states the fee is five hundred and twenty pounds.\",\"evidence\":\"expedition fee is five hundred and twenty pounds\"},{\"id\":\"l11-q7\",\"questionNumber\":7,\"type\":\"sentence_completion\",\"topic\":\"safety equipment\",\"estimatedBand\":7,\"prompt\":\"Supplied safety item: digital ____ transceiver.\",\"correctAnswer\":\"avalanche\",\"explanation\":\"Thomas states climbers must carry a certified digital avalanche transceiver.\",\"evidence\":\"carry a certified digital avalanche transceiver\"},{\"id\":\"l11-q8\",\"questionNumber\":8,\"type\":\"sentence_completion\",\"topic\":\"gear\",\"estimatedBand\":7,\"prompt\":\"Participants must bring their own ____-rated boots.\",\"correctAnswer\":\"B2\",\"explanation\":\"Thomas notes: 'must bring your own B2-rated mountaineering boots'.\",\"evidence\":\"bring your own B2-rated mountaineering boots compatible with semi-automatic crampons.\"},{\"id\":\"l11-q9\",\"questionNumber\":9,\"type\":\"sentence_completion\",\"topic\":\"dates\",\"estimatedBand\":6,\"prompt\":\"Meeting date: Sunday, January ____\",\"correctAnswer\":[\"12th\",\"12\",\"twelfth\"],\"explanation\":\"Thomas confirms Sunday, January the twelfth.\",\"evidence\":\"Sunday, January the twelfth, at the Pine Lodge Mountain Base.\"},{\"id\":\"l11-q10\",\"questionNumber\":10,\"type\":\"sentence_completion\",\"topic\":\"time\",\"estimatedBand\":5.5,\"prompt\":\"Gear check starts at ____ PM.\",\"correctAnswer\":[\"8\",\"eight\",\"8:00\"],\"explanation\":\"Thomas specifies eight in the evening.\",\"evidence\":\"begins at eight in the evening on Sunday\"}]}]},{\"sectionNumber\":2,\"title\":\"Community Orientation: The Circular Economy E-Waste Recycling Hub\",\"contextDescription\":\"Facility Operations Manager Hannah (North American English speaker) orienting community volunteers and residents to the Eastside Circular Electronic Recycling and Recovery Depot.\",\"audioScript\":[{\"speaker\":\"Hannah (North American)\",\"text\":\"Good morning everyone, and welcome to the Eastside Circular Electronics Resource Recovery Hub! My name is Hannah. Across North America and Europe, electronic waste—or e-waste—is the fastest-growing municipal waste stream, expanding three times faster than standard household refuse. Consumer electronics contain toxic heavy metals like lead, cadmium, and mercury, but they also harbor extraordinary concentrations of precious and critical raw materials: gold, silver, copper, palladium, and lithium.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"In fact, one metric ton of discarded smartphone circuit boards contains forty times more gold than a metric ton of freshly mined gold ore! Our mission here is to divert obsolete technology from incinerators, refurbishing usable devices for low-income school children and disassembling the rest into pure, high-grade commodity streams for domestic smelting.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"Let me orient you to our facility floor plan. Right now, we are assembled at the Main Drop-Off Bay on the southern entrance. Directly ahead of you to the northwest, location A marks the Battery & Hazardous Chemistry Cell. Here, technicians safely discharge and isolate damaged lithium-ion batteries inside fire-suppressant vermiculite barrels to prevent thermal runaway fires.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"Moving northeast from the entrance, location B is the Secure Data Destruction Suite. In this locked chamber, decommissioned hard drives and solid-state drives undergo automated physical degaussing followed by hydraulic shredding into two-millimeter particulate chips to guarantee zero data recovery.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"Location C in the center of the facility is the Diagnostic and Refurbishment Cleanroom. Our trained volunteers test computer motherboards, upgrade RAM, and install lightweight open-source Linux operating systems on donated laptops.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"Finally, at the far northern wall, location D marks the Automated Circuit Board Disassembly Line. Robotic desoldering arms harvest rare-earth capacitors, microprocessors, and copper heat pipes.\"},{\"speaker\":\"Hannah (North American)\",\"text\":\"A crucial safety protocol for all volunteers today: anti-static wrist straps and steel-toed boots must be worn in the cleanroom, and protective Kevlar gloves are mandatory whenever handling cracked glass screens. Let's begin our tour!\"}],\"questionGroups\":[{\"groupInstruction\":\"Choose the correct letter, A, B, or C. Write your answers in boxes 11–16.\",\"questionType\":\"multiple_choice_single\",\"questions\":[{\"id\":\"l11-q11\",\"questionNumber\":11,\"type\":\"multiple_choice_single\",\"topic\":\"e-waste\",\"estimatedBand\":6.5,\"prompt\":\"Electronic waste is expanding how much faster than ordinary domestic trash?\",\"options\":[\"Twice as fast.\",\"Ten times faster.\",\"Three times faster.\"],\"correctAnswer\":\"C\",\"explanation\":\"Hannah states e-waste is expanding three times faster than standard household refuse.\",\"evidence\":\"expanding three times faster than standard household refuse.\"},{\"id\":\"l11-q12\",\"questionNumber\":12,\"type\":\"multiple_choice_single\",\"topic\":\"mining\",\"estimatedBand\":7,\"prompt\":\"One ton of smartphone circuit boards contains how much more gold than mined ore?\",\"options\":[\"40 times more.\",\"10 times more.\",\"100 times more.\"],\"correctAnswer\":\"A\",\"explanation\":\"Hannah highlights that circuit boards contain forty times more gold than mined ore.\",\"evidence\":\"contains forty times more gold than a metric ton of freshly mined gold ore!\"},{\"id\":\"l11-q13\",\"questionNumber\":13,\"type\":\"multiple_choice_single\",\"topic\":\"safety\",\"estimatedBand\":7,\"prompt\":\"Lithium batteries are stored inside barrels filled with\",\"options\":[\"salt water.\",\"vermiculite.\",\"shredded paper.\"],\"correctAnswer\":\"B\",\"explanation\":\"Hannah notes lithium batteries are stored inside fire-suppressant vermiculite barrels.\",\"evidence\":\"isolate damaged lithium-ion batteries inside fire-suppressant vermiculite barrels\"},{\"id\":\"l11-q14\",\"questionNumber\":14,\"type\":\"multiple_choice_single\",\"topic\":\"security\",\"estimatedBand\":7,\"prompt\":\"To guarantee data security, shredded hard drives are chopped into pieces of\",\"options\":[\"10 millimeters.\",\"25 millimeters.\",\"2 millimeters.\"],\"correctAnswer\":\"C\",\"explanation\":\"Hannah explains hydraulic shredding cuts drives into two-millimeter particulate chips.\",\"evidence\":\"hydraulic shredding into two-millimeter particulate chips to guarantee zero data recovery.\"},{\"id\":\"l11-q15\",\"questionNumber\":15,\"type\":\"multiple_choice_single\",\"topic\":\"technology\",\"estimatedBand\":6.5,\"prompt\":\"Refurbished