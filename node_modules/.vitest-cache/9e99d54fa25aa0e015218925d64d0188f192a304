const __vite_ssr_export_default__ = /* #__PURE__ */ JSON.parse("[\n  {\n    \"id\": \"gram-01\",\n    \"title\": \"Present & Past Tenses in IELTS\",\n    \"focus\": \"Selecting correct tense when describing past charts, general truths, and ongoing trends.\",\n    \"explanation\": \"In IELTS Writing Task 1, tense selection is governed strictly by the timeline in the prompt. If the chart covers historical years (e.g., 2000 to 2020), you must use past simple (e.g. \\\"surged\\\", \\\"remained static\\\"). If no timeframe is provided, use present simple for general truths. In Task 2, present simple describes ongoing social phenomena, while present perfect connects past trends to current situations.\",\n    \"bandTips\": \"Avoid mixing past and present tenses within a single descriptive sentence. E.g. \\\"In 2010, vehicle sales rose and are peaking\\\" is incorrect. Use \\\"rose and peaked\\\".\",\n    \"exercises\": [\n      {\n        \"id\": \"g01-q01\",\n        \"prompt\": \"Between 2012 and 2018, the volume of plastic waste _________ steadily from 4 million to 6.5 million tons.\",\n        \"options\": [\n          \"increased\",\n          \"increases\",\n          \"has increased\",\n          \"is increasing\"\n        ],\n        \"correctAnswer\": \"increased\",\n        \"explanation\": \"Past simple (\\\"increased\\\") is mandatory because the time boundary (2012–2018) is completely in the past.\"\n      },\n      {\n        \"id\": \"g01-q02\",\n        \"prompt\": \"In recent decades, urbanization _________ the demographic landscape of developing economies.\",\n        \"options\": [\n          \"transformed\",\n          \"has transformed\",\n          \"transforms\",\n          \"is transform\"\n        ],\n        \"correctAnswer\": \"has transformed\",\n        \"explanation\": \"Present perfect (\\\"has transformed\\\") is appropriate because \\\"In recent decades\\\" indicates an ongoing trend that began in the past and continues into the present.\"\