const sections = /* #__PURE__ */ JSON.parse("[{\"sectionNumber\":1,\"title\":\"Community Sports Pavilion Tennis Court Membership\",\"contextDescription\":\"Priya (Indian English speaker) enquiring with Sports Pavilion Manager Liam (Australian English speaker) about joining the local tennis and squash club.\",\"audioScript\":[{\"speaker\":\"Liam (Australian)\",\"text\":\"Good morning! Westside Community Sports Pavilion. Liam speaking.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"Hello Liam! My name is Priya Sharma. I recently moved to the area and would love to register for an annual tennis club membership.\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"No worries, Priya! We have both outdoor floodlit synthetic grass courts and indoor squash courts. Let me take down your contact details.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"Certainly. My first name is Priya, P-R-I-Y-A, and surname Sharma, S-H-A-R-M-A.\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"Thank you, Priya. And your home address?\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"I reside at sixty-three Acacia Crescent, Perth, postcode six zero零eight—that is six zero zero eight.\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"Six zero zero eight. And a contact mobile number?\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"It is zero four nine nine, eight seven six five four three.\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"Got it. Now regarding our membership packages, our Individual Full Adult pass is fifty-five dollars per month, or five hundred and fifty dollars if paid annually upfront, which gives you two months free.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"I will take the annual upfront payment for five hundred and fifty dollars. Does that fee include nighttime floodlight tokens?\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"Yes, annual members receive fifty complimentary digital lighting tokens loaded onto their electronic access card. Additional tokens can be topped up via our mobile app for two dollars per hour.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"That is very convenient. What footwear regulations apply to the synthetic grass courts?\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"All players must wear non-marking rubber court shoes with flat herringbone tread; running shoes with aggressive black cleat soles are strictly banned to prevent tearing the artificial turf fibers.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"Understood. When does the beginner-intermediate social doubles round-robin meet?\"},{\"speaker\":\"Liam (Australian)\",\"text\":\"Every Thursday evening at seven PM. You can simply turn up and our club coach organizes matched pairs.\"},{\"speaker\":\"Priya (Indian English)\",\"text\":\"Thursday at seven PM. Thank you so much, Liam! I will pop in tomorrow to pay and collect my access card.\"}],\"questionGroups\":[{\"groupInstruction\":\"Complete the form below. Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer. Write your answers in boxes 1–10.\",\"questionType\":\"sentence_completion\",\"questions\":[{\"id\":\"l12-q1\",\"questionNumber\":1,\"type\":\"sentence_completion\",\"topic\":\"customer enquiry\",\"estimatedBand\":5.5,\"prompt\":\"Applicant surname: ____\",\"correctAnswer\":\"Sharma\",\"explanation\":\"Priya spells her surname: S-H-A-R-M-A.\",\"evidence\":\"surname Sharma, S-H-A-R-M-A.\"},{\"id\":\"l12-q2\",\"questionNumber\":2,\"type\":\"sentence_completion\",\"topic\":\"address\",\"estimatedBand\":5.5,\"prompt\":\"Address: 63 ____ Crescent, Perth.\",\"correctAnswer\":\"Acacia\",\"explanation\":\"Priya states: sixty-three Acacia Crescent.\",\"evidence\":\"sixty-three Acacia Crescent, Perth\"},{\"id\":\"l12-q3\",\"questionNumber\":3,\"type\":\"sentence_completion\",\"topic\":\"postcode\",\"estimatedBand\":6,\"prompt\":\"Postcode: ____\",\"correctAnswer\":[\"6008\",\"six zero zero eight\"],\"explanation\":\"Priya confirms: six zero zero eight