{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZariiCourseLesson",
  "description": "Schema for Zarii English Course lessons, sections, and exercises.",
  "type": "object",
  "required": [
    "id",
    "level",
    "unit",
    "order",
    "title",
    "objectives",
    "estimatedMinutes",
    "prerequisites",
    "skillTags",
    "vocabularyList",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^eng-[a-c][1-2]-u[0-9]+-l[0-9]+$"
    },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1"]
    },
    "unit": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skillTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "vocabularyList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "partOfSpeech", "definition"],
        "properties": {
          "word": { "type": "string" },
          "partOfSpeech": { "type": "string" },
          "phonetic": { "type": "string" },
          "definition": { "type": "string" },
          "urduMeaning": { "type": "string" },
          "exampleSentence": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "explain",
              "examples",
              "timeline",
              "dialogue",
              "practice",
              "listening",
              "speaking",
              "writing",
              "quiz",
              "summary",
              "urduNote"
            ]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["headers", "rows"],
              "properties": {
                "title": { "type": "string" },
                "headers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          },
          "callouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": { "type": "string", "enum": ["tip", "note", "warning", "cultural"] },
                "title": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["english"],
              "properties": {
                "english": { "type": "string" },
                "urdu": { "type": "string" },
                "audioText": { "type": "string" },
                "phonetic": { "type": "string" },
                "context": { "type": "string" }
              }
            }
          },
          "timeline": {
            "type": "object",
            "required": ["past", "present", "future", "activePoint"],
            "properties": {
              "title": { "type": "string" },
              "past": { "type": "string" },
              "present": { "type": "string" },
              "future": { "type": "string" },
              "activePoint": { "type": "string", "enum": ["past", "present", "future", "continuous", "perfect"] },
              "explanation": { "type": "string" }
            }
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["speaker", "english"],
              "properties": {
                "speaker": { "type": "string" },
                "avatar": { "type": "string" },
                "english": { "type": "string" },
                "urdu": { "type": "string" },
                "audioText": { "type": "string" }
              }
            }
          },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "prompt", "explanation"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": [
                    "mcq",
                    "fill_blank",
                    "order_sentence",
                    "match_pairs",
                    "sort_categories",
                    "error_correction",
                    "sentence_transformation",
                    "true_false",
                    "listen_type",
                    "repeat_after_me",
                    "short_writing"
                  ]
                },
                "skillTag": { "type": "string" },
                "prompt": { "type": "string" },
                "audioPrompt": { "type": "string" },
                "explanation": { "type": "string", "minLength": 5 },
                "urduExplanation": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "text"],
                    "properties": {
                      "id": { "type": "string" },
                      "text": { "type": "string" },
                      "isPinned": { "type": "boolean" }
                    }
                  }
                },
                "correctOptionId": { "type": "string" },
                "correctAnswer": { "type": "string" },
                "acceptableAnswers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "sentenceTokens": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "correctOrder": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "pairs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["left", "right"],
                    "properties": {
                      "left": { "type": "string" },
                      "right": { "type": "string" }
                    }
                  }
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["category", "items"],
                    "properties": {
                      "category": { "type": "string" },
                      "items": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                },
                "modelAnswer": { "type": "string" },
                "evaluationCriteria": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "audio": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "speed": { "type": "number" },
              "accent": { "type": "string", "enum": ["en-US", "en-GB"] }
            }
          },
          "summaryPoints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "urduText": { "type": "string" }
        }
      }
    }
  }
}
